<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Astra Bridge Mac agent: user LaunchAgent (gui/<uid> domain, no sudo).

  Do not fill in the double-brace placeholders by hand. Render this file with
  relay/scripts/install-agent.mjs (see its help), which validates every value the same
  way the agent does at startup, XML-escapes it, and by default only prints the result.

  ProcessType is deliberately NOT set. With ProcessType=Background, launchd throttles the
  job while the Mac is busy right after boot and login; in practice that delayed the
  agent start by several minutes (around ten) after a reboot. Without a ProcessType the
  agent starts as soon as you log in.

  KeepAlive/SuccessfulExit=false: launchd restarts the agent whenever it exits with an
  error (for example a missing key file, invalid ASTRA_* settings, or mcp-commander failing
  to start; an unreachable relay is retried inside the agent), at most once
  every ThrottleInterval seconds. A clean exit is not restarted.

  No secret is stored in this file. The agent reads its private key from
  ASTRA_AGENT_KEY_FILE (default ~/.astra-bridge/agent-private.pem).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.astra-bridge-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{NODE}}</string>
		<string>{{AGENT_PATH}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{WORKING_DIR}}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ASTRA_RELAY_URL</key>
		<string>{{RELAY_URL}}</string>
		<key>ASTRA_RELAY_HOST</key>
		<string>{{RELAY_HOST}}</string>
		<key>ASTRA_DEVICE_ID</key>
		<string>{{DEVICE_ID}}</string>
{{OPTIONAL_ENV}}
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{LOG_DIR}}/agent.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>{{LOG_DIR}}/agent.stderr.log</string>
</dict>
</plist>
